inputFile               : NastranPreProc
toolVersion             : 0.0.0
%_______________________________________________________________________________________________________
% General rules for this input file
%  - The inputFile and toolVersion commands should always be specified before <START>
%  - Only lines between the <START> and <END> commands are processed
%  - Commands are assigned by specifying a value after the colon
%  - Only lines with a colon are processed
%  - Use a space on both sides of the colon
%  - Lines beginning with a percent sign are not processed
%  - Comments can be added after a value using a percent sign
%_______________________________________________________________________________________________________

<START> % Lines after this point are processed

% REQUIRED INPUTS (needed for the tool to work)
PATHS.WORKING_DIR             : 'C:\path\to\case'
PATHS.TEMPLATE_BDF            : 'C:\Users\Santiago\MASTER_ANSYS\05_TFM\NastranFlutter\Templates\AeroelasticStudy_145.bdf'
PATHS.OUTPUT_BDF              : 'C:\path\to\case\AeroelasticStudy_145_run.bdf'
PATHS.NASTRAN_EXE             : 'C:\Program Files\Siemens\Simcenter3D_XXXX\NXNASTRAN\bin\nastranw.exe'
MODEL.UNIT_SYSTEM             : 'SI'
MODEL.SOL                     : 145
STEPS.doPreProcess            : true
STEPS.doWriteBDF              : true
STEPS.doRunNastran            : false
STEPS.doPostProcess           : false
STEOS.doPlotGrid              : true
STEOS.doPlotCrossSection      : true

% OPTIONAL INPUTS (blank = use hardcoded defaults in Tools/DefaultOptions.m)
OPTIONAL.PATHS.CROSS_SECTION_INPUT      : 'C:\Users\Santiago\MASTER_ANSYS\05_TFM\NastranFlutter\Templates\Cross_Section.inp'  % DEFAULT: ''
OPTIONAL.PATHS.WING_GEOMETRY_INPUT      : 'C:\Users\Santiago\MASTER_ANSYS\05_TFM\NastranFlutter\Templates\Wing_Geometry.inp' % DEFAULT: ''
OPTIONAL.PATHS.MESH_INPUT               : 'C:\Users\Santiago\MASTER_ANSYS\05_TFM\NastranFlutter\Templates\Mesh_Input.inp' % DEFAULT: ''
OPTIONAL.RUN.NASTRAN_ARGUMENTS        :                      % DEFAULT: {'scr=yes','old=no'}
OPTIONAL.RUN.DELETE_F04               :                      % DEFAULT: false
OPTIONAL.RUN.DELETE_F06               :                      % DEFAULT: false
OPTIONAL.RUN.DELETE_LOG               :                      % DEFAULT: false
OPTIONAL.PARAM.DENSITY_SCALE          :                      % DEFAULT: 1.0
OPTIONAL.PARAM.STIFFNESS_SCALE        :                      % DEFAULT: 1.0
OPTIONAL.PARAM.SPAN_SCALE             :                      % DEFAULT: 1.0
OPTIONAL.PARAM.CHORD_SCALE            :                      % DEFAULT: 1.0
OPTIONAL.OUTPUT.WRITE_PARSED_INPUT    :                      % DEFAULT: true
OPTIONAL.OUTPUT.PARSED_INPUT_FILENAME :                      % DEFAULT: 'NastranPreProc_parsedInput.mat'
OPTIONAL.OUTPUT.LOG_FILENAME          :                      % DEFAULT: 'NastranPreProc.log'

<END> % Lines after this point are not processed

%_______________________________________________________________________________________________________
% REQUIRED INPUTS
%_______________________________________________________________________________________________________
% PATHS.WORKING_DIR  : Working directory for generated files and solver execution.
% PATHS.TEMPLATE_BDF : Source BDF template used by the preprocessor.
% PATHS.OUTPUT_BDF   : Output BDF generated by the preprocessor.
% PATHS.NASTRAN_EXE  : Full path to the Nastran executable.
% MODEL.UNIT_SYSTEM  : User unit system label (e.g. 'SI', 'N-mm-ton').
% MODEL.SOL          : Nastran solution sequence (e.g. 145 for flutter).
% STEPS.doPreProcess : Enable parsing/preprocessing stage.
% STEPS.doWriteBDF   : Enable BDF write stage.
% STEPS.doRunNastran : Enable solver execution stage.
% STEPS.doPostProcess: Enable post-processing stage.
% STEOS.doPlotGrid   : Generate lightweight 3D plot of GRID + shell mesh and XYZ triad.
% STEOS.doPlotCrossSection : Plot 2D normalized cross-section vertices if a cross-section input path is provided.
%
%_______________________________________________________________________________________________________
% OPTIONAL INPUTS
%_______________________________________________________________________________________________________
% OPTIONAL.* values are merged on top of hardcoded defaults in:
%   Tools/DefaultOptions.m
% Leave them blank to keep the defaults.
% OPTIONAL.PATHS.WING_GEOMETRY_INPUT : Path to wing geometry definition file (chord/stringers/ribs).
% OPTIONAL.PATHS.MESH_INPUT          : Path to structured mesh definition file (edge/rib divisions + rib surfaces).

